# Copy to .env.local and fill in. Never commit real keys.

# Marketplace origin used by links on fastchina.store (leave empty in local dev)
NEXT_PUBLIC_SHOP_URL=https://fastchina.shop
# Hosts that should serve the fastchina.store site
STORE_HOSTS=fastchina.store,www.fastchina.store

# Supabase (backend project, connected later)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used by route handlers and edge functions, never exposed to the browser.
SUPABASE_SECRET_KEY=

# Email (Resend). Verify the sending domain in Resend first (DNS records).
RESEND_API_KEY=
EMAIL_FROM="FastChina <orders@fastchina.shop>"
EMAIL_REPLY_TO=help@fastchina.shop
# Public site address used in email links and by the database to call /api/notify/drain
SITE_URL=https://fastchina.shop
# Signs unsubscribe links (any long random string; falls back to SUPABASE_SECRET_KEY)
UNSUBSCRIBE_SECRET=
# Resend → Webhooks: endpoint https://fastchina.shop/api/resend/webhook, events delivered/bounced/complained/delivery_delayed
RESEND_WEBHOOK_SECRET=

# Accounts
# Emails that become Super admin when they sign up (comma separated).
SUPER_ADMIN_EMAILS=
# Shown in Settings → Connect to us.
NEXT_PUBLIC_SUPPORT_EMAIL=support@fastchina.shop
# WhatsApp number in international format without +, e.g. 2348030000000 (optional).
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Search
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
INDEXNOW_KEY=
